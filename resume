<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kokou Eklou-Agnide — Resume</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F7F9FB;
    --paper:#FFFFFF;
    --ink:#1A2333;
    --ink-soft:#4B5768;
    --line:#DDE4EC;
    --accent:#0E6E63;
    --accent-soft:#E4F1EE;
    --mono:'IBM Plex Mono', monospace;
    --sans:'IBM Plex Sans', -apple-system, sans-serif;
  }

  *{ box-sizing:border-box; }

  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
  }

  .page{
    max-width:800px;
    margin:48px auto;
    background:var(--paper);
    border:1px solid var(--line);
    box-shadow:0 1px 3px rgba(20,30,45,0.04);
    padding:56px 60px 48px;
  }

  /* ---------- Header ---------- */
  header{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:24px;
    padding-bottom:22px;
    border-bottom:2px solid var(--ink);
  }

  h1{
    font-size:30px;
    letter-spacing:0.01em;
    margin:0 0 6px;
    font-weight:700;
  }

  .role-tag{
    font-family:var(--mono);
    font-size:12.5px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:var(--accent);
    background:var(--accent-soft);
    display:inline-block;
    padding:3px 9px;
    border-radius:3px;
  }

  .contact{
    text-align:right;
    font-size:13px;
    color:var(--ink-soft);
    line-height:1.9;
    font-family:var(--mono);
    white-space:nowrap;
  }

  .contact a{ color:var(--ink-soft); text-decoration:none; }
  .contact a:hover{ color:var(--accent); }

  /* ---------- Signature network divider ---------- */
  .net-divider{
    display:flex;
    align-items:center;
    gap:6px;
    margin:34px 0 26px;
  }
  .net-divider .node{
    width:5px; height:5px; border-radius:50%;
    background:var(--line);
    flex:none;
  }
  .net-divider .node.on{ background:var(--accent); }
  .net-divider .seg{
    height:1px;
    background:var(--line);
    flex:1;
  }

  /* ---------- Section ---------- */
  section{ margin-top:30px; }
  section:first-of-type{ margin-top:0; }

  .eyebrow{
    font-family:var(--mono);
    font-size:11.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--accent);
    margin:0 0 14px;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .eyebrow::after{
    content:"";
    flex:1;
    height:1px;
    background:var(--line);
  }

  .summary{
    font-size:14.5px;
    line-height:1.7;
    color:var(--ink-soft);
    margin:0;
    max-width:66ch;
  }

  /* ---------- Education / Experience entries ---------- */
  .entry{
    padding-left:16px;
    border-left:2px solid var(--line);
    margin-bottom:20px;
    position:relative;
  }
  .entry::before{
    content:"";
    position:absolute;
    left:-5px;
    top:4px;
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--paper);
    border:2px solid var(--accent);
  }
  .entry:last-child{ margin-bottom:0; }

  .entry-head{
    display:flex;
    justify-content:space-between;
    align-items:baseline;
    flex-wrap:wrap;
    gap:4px 16px;
  }

  .entry-title{
    font-weight:600;
    font-size:15px;
  }

  .entry-org{
    font-weight:400;
    color:var(--ink-soft);
  }

  .entry-date{
    font-family:var(--mono);
    font-size:12px;
    color:var(--ink-soft);
    white-space:nowrap;
  }

  .entry-sub{
    font-size:12.5px;
    color:var(--ink-soft);
    margin-top:2px;
    font-family:var(--mono);
  }

  ul.bullets{
    margin:10px 0 0;
    padding-left:18px;
  }
  ul.bullets li{
    font-size:13.8px;
    line-height:1.65;
    color:var(--ink);
    margin-bottom:5px;
  }
  ul.bullets li::marker{
    color:var(--accent);
  }

  .coursework{
    font-size:13px;
    color:var(--ink-soft);
    margin-top:8px;
  }
  .coursework strong{
    color:var(--ink);
    font-weight:600;
  }

  /* ---------- Two-column grid for certs / skills ---------- */
  .grid-2{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:36px;
  }

  .cert-list{
    list-style:none;
    margin:0; padding:0;
  }
  .cert-list li{
    font-size:13.5px;
    padding:7px 0;
    border-bottom:1px dashed var(--line);
    display:flex;
    justify-content:space-between;
    gap:10px;
    align-items:baseline;
  }
  .cert-list li:last-child{ border-bottom:none; }
  .cert-status{
    font-family:var(--mono);
    font-size:10.5px;
    color:var(--accent);
    background:var(--accent-soft);
    padding:1px 6px;
    border-radius:3px;
    white-space:nowrap;
  }

  .skill-row{
    margin-bottom:12px;
  }
  .skill-row:last-child{ margin-bottom:0; }
  .skill-label{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:var(--accent);
    display:block;
    margin-bottom:4px;
  }
  .skill-value{
    font-size:13.3px;
    color:var(--ink);
    line-height:1.55;
  }

  /* ---------- Print ---------- */
  @media print{
    body{ background:var(--paper); }
    .page{
      margin:0;
      border:none;
      box-shadow:none;
      padding:0.4in 0.5in;
      max-width:none;
    }
  }

  @media (max-width:640px){
    .page{ padding:32px 22px; margin:0; border:none; }
    header{ flex-direction:column; align-items:flex-start; gap:10px; }
    .contact{ text-align:left; }
    .grid-2{ grid-template-columns:1fr; gap:24px; }
    .entry-head{ flex-direction:column; }
  }
</style>
</head>
